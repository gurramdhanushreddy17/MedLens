// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id              String   @id @default(cuid())
  name            String
  age             Int
  sex             String
  dateOfBirth     DateTime?
  contactInfo     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  profileEntries  PatientProfileEntry[]
  reports         MedicalReport[]
  labResults      LabResult[]
  summaries       AISummary[]
  inconsistencies InconsistencyFlag[]
  auditLogs       AuditLog[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([name])
  @@index([createdBy])
}

model PatientProfileEntry {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category  String   // symptom | existing_condition | allergy | medication | other
  value     String
  notes     String?
  source    String   @default("user-entered")
  enteredBy String
  enteredAt DateTime @default(now())

  @@index([patientId])
  @@index([category])
  @@index([patientId, category])
}

model MedicalReport {
  id               String    @id @default(cuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  filePath         String
  fileType         String
  originalFilename String
  reportDate       DateTime?
  uploadedBy       String
  uploadedAt       DateTime  @default(now())
  processingStatus String    @default("pending") // pending | processing | processed | failed | needs_review
  rawExtractedText String?
  labResults       LabResult[]

  @@index([patientId])
  @@index([processingStatus])
  @@index([uploadedAt])
  @@index([patientId, processingStatus])
}

model LabResult {
  id                  String        @id @default(cuid())
  reportId            String
  report              MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName            String
  value               String
  unit                String?
  referenceRangeLow   Float?
  referenceRangeHigh  Float?
  referenceRangeRaw   String?
  flag                String        @default("unknown") // low | normal | high | unknown
  observationNote     String?
  source              String        @default("ai-extracted")
  confidence          Float
  verifiedByClinician Boolean       @default(false)
  verifiedBy          String?
  verifiedAt          DateTime?

  @@index([patientId])
  @@index([reportId])
  @@index([testName])
  @@index([flag])
  @@index([verifiedByClinician])
  @@index([patientId, testName])
}

model AISummary {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  summaryText      String
  generatedAt      DateTime @default(now())
  modelVersion     String
  source           String   @default("ai-generated")
  basedOnReportIds String[]
  disclaimerShown  Boolean  @default(true)

  @@index([patientId])
  @@index([generatedAt])
}

model InconsistencyFlag {
  id                  String   @id @default(cuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type                String   // value_conflict | date_conflict | missing_range | duplicate_test
  description         String
  relatedLabResultIds String[]
  resolved            Boolean  @default(false)
  resolvedBy          String?
  resolvedAt          DateTime?

  @@index([patientId])
  @@index([resolved])
  @@index([type])
  @@index([patientId, resolved])
}

model AuditLog {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  actorId    String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    Json?

  @@index([patientId])
  @@index([timestamp])
  @@index([action])
  @@index([actorId])
  @@index([patientId, timestamp])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // admin only
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([role])
}
